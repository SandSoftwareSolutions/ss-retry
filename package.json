{
  "name": "@sandsoftwaresolutions/retry",
  "version": "0.1.1",
  "description": "Retry with growing waits, jitter, a time limit per attempt, cancellation and Retry-After support.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "retry",
    "backoff",
    "jitter",
    "resilience"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-retry.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-retry/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-retry#readme",
  "publishConfig": {
    "access": "public"
  }
}
